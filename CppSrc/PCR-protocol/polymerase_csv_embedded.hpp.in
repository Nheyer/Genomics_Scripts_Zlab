// Generated at configure time by CMake from Data/polymerases.csv.
// Do not edit, and do not commit the generated copy - edit the CSV instead.
//
// The CSV is embedded verbatim rather than re-encoded as a polymerase table, so
// there is exactly one copy of the data and the built-in table is parsed by
// the same loader that --polymerase-db uses on a file.
#ifndef POLYMERASE_CSV_EMBEDDED_HPP
#define POLYMERASE_CSV_EMBEDDED_HPP

inline constexpr char EMBEDDED_POLYMERASE_CSV[] = R"POLYMERASECSV(@POLYMERASE_CSV_CONTENTS@)POLYMERASECSV";

#endif  // POLYMERASE_CSV_EMBEDDED_HPP
